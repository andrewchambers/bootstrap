@@ -15,13 +15,28 @@
 
 int recurse_status = 0;
 
+struct entry {
+	char *name;
+	struct stat st;
+};
+
+static int
+entrycmp(const void *a, const void *b)
+{
+	const struct entry *ea = a, *eb = b;
+
+	return strcmp(ea->name, eb->name);
+}
+
 void
 recurse(int dirfd, const char *name, void *data, struct recursor *r)
 {
 	struct dirent *d;
+	struct entry *entries = NULL;
 	struct history *new, *h;
 	struct stat st, dst;
 	DIR *dp;
+	size_t entrieslen = 0, i;
 	int flags = 0, fd;
 	size_t pathlen = r->pathlen;
 
@@ -73,22 +88,52 @@ recurse(int dirfd, const char *name, void *data, struct recursor *r)
 		if (r->path[pathlen - 1] != '/')
 			r->path[pathlen++] = '/';
 		if (r->follow == 'H')
 			flags |= AT_SYMLINK_NOFOLLOW;
-		while ((d = readdir(dp))) {
-			if (!strcmp(d->d_name, ".") || !strcmp(d->d_name, ".."))
-				continue;
-			r->pathlen = pathlen + estrlcpy(r->path + pathlen, d->d_name, sizeof(r->path) - pathlen);
-			if (fstatat(fd, d->d_name, &dst, flags) < 0) {
-				if (!(r->flags & SILENT)) {
-					weprintf("stat %s:", r->path);
-					recurse_status = 1;
+		if (r->flags & SORT) {
+			while ((d = readdir(dp))) {
+				if (!strcmp(d->d_name, ".") || !strcmp(d->d_name, ".."))
+					continue;
+				r->pathlen = pathlen + estrlcpy(r->path + pathlen, d->d_name, sizeof(r->path) - pathlen);
+				if (fstatat(fd, d->d_name, &dst, flags) < 0) {
+					if (!(r->flags & SILENT)) {
+						weprintf("stat %s:", r->path);
+						recurse_status = 1;
+					}
+				} else if ((r->flags & SAMEDEV) && dst.st_dev != st.st_dev) {
+					continue;
+				} else {
+					entries = ereallocarray(entries, entrieslen + 1, sizeof(*entries));
+					entries[entrieslen].name = estrdup(d->d_name);
+					entries[entrieslen].st = dst;
+					entrieslen++;
+				}
+			}
+			qsort(entries, entrieslen, sizeof(*entries), entrycmp);
+			for (i = 0; i < entrieslen; i++) {
+				r->pathlen = pathlen + estrlcpy(r->path + pathlen, entries[i].name, sizeof(r->path) - pathlen);
+				r->depth++;
+				r->fn(fd, entries[i].name, &entries[i].st, data, r);
+				r->depth--;
+				free(entries[i].name);
+			}
+			free(entries);
+		} else {
+			while ((d = readdir(dp))) {
+				if (!strcmp(d->d_name, ".") || !strcmp(d->d_name, ".."))
+					continue;
+				r->pathlen = pathlen + estrlcpy(r->path + pathlen, d->d_name, sizeof(r->path) - pathlen);
+				if (fstatat(fd, d->d_name, &dst, flags) < 0) {
+					if (!(r->flags & SILENT)) {
+						weprintf("stat %s:", r->path);
+						recurse_status = 1;
+					}
+				} else if ((r->flags & SAMEDEV) && dst.st_dev != st.st_dev) {
+					continue;
+				} else {
+					r->depth++;
+					r->fn(fd, d->d_name, &dst, data, r);
+					r->depth--;
 				}
-			} else if ((r->flags & SAMEDEV) && dst.st_dev != st.st_dev) {
-				continue;
-			} else {
-				r->depth++;
-				r->fn(fd, d->d_name, &dst, data, r);
-				r->depth--;
 			}
 		}
 		r->path[pathlen - 1] = '\0';
 		r->pathlen = pathlen - 1;
